{
  "name": "kage-baileys",
  "version": "3.2.21",
  "description": "Kage Baileys: API de WhatsApp con comunidades, canales, medios y herramientas de diagnóstico.",
  "keywords": [
    "kage-baileys",
    "baileys",
    "whatsapp",
    "whatsapp-api",
    "whatsapp-bot",
    "botones",
    "newsletter",
    "meta-ai",
    "voip",
    "multi-device",
    "xrljosedv"
  ],
  "homepage": "https://github.com/xrljosedv/kage-baileys",
  "repository": {
    "url": "git+https://github.com/xrljosedv/kage-baileys.git",
    "type": "git"
  },
  "license": "MIT",
  "author": "xrljosedv",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*",
    "WAProto/**/*",
    "engine-requirements.js",
    "scripts/**/*",
    "Example/**/*",
    "maintenance/**/*",
    "test/**/*",
    "licenses/**/*",
    "README.MD",
    "LICENSE",
    "tsconfig.json"
  ],
  "scripts": {
    "gen:protobuf": "node scripts/generate-protobuf.cjs",
    "lint": "node scripts/check-syntax.cjs && node scripts/check-imports.cjs",
    "test": "node --test test/*.test.cjs",
    "check": "npm run lint && npm run check:types && npm test && npm run check:package",
    "example": "node Example/connection.cjs",
    "gen:types": "node scripts/generate-public-types.cjs",
    "check:engine": "node engine-requirements.js",
    "prepublishOnly": "npm run build && npm run check",
    "maintenance": "node scripts/maintenance.cjs",
    "check:imports": "node scripts/check-imports.cjs",
    "check:types": "tsc -p tsconfig.json",
    "build": "npm run check:engine && npm run gen:protobuf && npm run gen:types",
    "check:package": "node scripts/check-package.cjs",
    "prepack": "npm run check:package"
  },
  "dependencies": {
    "@adiwajshing/keyed-db": "^0.2.4",
    "@cacheable/node-cache": "^1.4.0",
    "@hapi/boom": "^9.1.3",
    "@img/sharp-wasm32": "^0.35.5",

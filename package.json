    "cache-manager": "^5.7.6",
    "cfonts": "^3.3.1",
    "chalk": "^4.1.2",
    "cheerio": "1.0.0",
    "fflate": "^0.8.0",
    "file-type": "21.3.4",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.0",
    "gradient-string": "^2.0.2",
    "jimp": "^1.6.1",
    "libphonenumber-js": "^1.10.20",
    "libsignal": "^6.0.0",
    "link-preview-js": "4.0.4",
    "lodash": "^4.17.21",
    "lru-cache": "10.4.3",
    "music-metadata": "11.16.1",
    "p-queue": "6.6.2",
    "pino": "^9.6",
    "protobufjs": "8.8.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "unfurl.js": "^6.4.0",
    "uuid": "11.1.1",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "node-addon-api": "^8.9.2",
    "protobufjs-cli": "^2.7.1",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "@napi-rs/image": "^1.12.0",
    "audio-decode": "^2.1.3",
    "better-sqlite3": ">=11",
    "sharp": "^0.34.1"
  },
  "peerDependenciesMeta": {
    "audio-decode": {
      "optional": true
    },
    "sharp": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "@napi-rs/image": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "optionalDependencies": {
    "@roamhq/wrtc": "*",
    "whatsapp-rust-bridge": "0.5.2"
  },
  "contributors": [
    "David Zuniga"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    },
    "./*": "./*"
  },

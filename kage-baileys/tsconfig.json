{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": [
    "lib/**/*.d.ts",
    "lib/index.js",
    "test/**/*.ts",
    "test/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "maintenance",
    "Example"
  ]
}

{
  "name": "kage-baileys",
  "version": "3.3.2",
  "description": "Kage Baileys — la mejor Baileys de 2026. API de WhatsApp Web con portada de perfil, avatares, botones, Native Flows, VoIP, canales, comunidades, Meta AI y más. Creador: José (xrljosedv).",
  "keywords": [
    "kage-baileys",
    "baileys",
    "whatsapp",
    "whatsapp-api",
    "whatsapp-bot",
    "cover-photo",
    "portada-whatsapp",
    "profile-cover",
    "botones",
    "native-flows",
    "newsletter",
    "canales",
    "comunidades",
    "meta-ai",
    "voip",
    "multi-device",
    "lid-mapping",
    "xrljosedv",
    "avatar",
    "default-avatar",
    "profile-picture-fallback",
    "whatsapp-avatar"
  ],
  "homepage": "https://github.com/xrljosedv/kage-baileys",
  "repository": {
    "url": "git+https://github.com/xrljosedv/kage-baileys.git",
    "type": "git"
  },
  "license": "MIT",
  "author": "xrljosedv",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*",
    "WAProto/**/*",
    "engine-requirements.js",
    "scripts/**/*",
    "Example/**/*",
    "maintenance/**/*",
    "test/**/*",
    "licenses/**/*",
    "LICENSE",
    "tsconfig.json",
    "docs/**/*",
    "README.md",
    "VERIFICACION.json",
    "reports/dependency-audit-2026-11-07.json",
    "reports/protocol-coverage-2026-11-07.json"
  ],
  "scripts": {
    "gen:protobuf": "node scripts/generate-protobuf.cjs",
    "lint": "node scripts/check-syntax.cjs && node scripts/check-imports.cjs",
    "test": "node --test test/*.test.cjs",
    "check": "npm run lint && npm run check:types && npm test && npm run check:package",
    "example": "node Example/connection.cjs",
    "gen:types": "node scripts/generate-public-types.cjs",
    "check:engine": "node engine-requirements.js",
    "prepublishOnly": "npm run build && npm run check",
    "maintenance": "node scripts/maintenance.cjs",
    "check:imports": "node scripts/check-imports.cjs",
    "check:types": "tsc -p tsconfig.json",
    "build": "npm run check:engine && npm run build:native && npm run gen:protobuf && npm run gen:types",
    "check:package": "node scripts/check-package.cjs",
    "prepack": "npm run check:package",
    "doctor": "node scripts/doctor.cjs",
    "test:images": "node --test test/image-processing.test.cjs",
    "start": "node scripts/start-bot.cjs",
    "setup:bot": "npm --prefix bot install",
    "test:merge": "node --test test/project-merge.test.cjs",
    "test:bot": "npm --prefix bot test",
    "test:protocol": "node --test test/protocol-update.test.cjs",
    "test:runtime": "node --test test/project-merge.test.cjs",
    "build:native": "node scripts/build-native.cjs",
    "test:native": "node --test test/native-tools.test.cjs"
  },
  "dependencies": {
    "@adiwajshing/keyed-db": "^0.2.4",
